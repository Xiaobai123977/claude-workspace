{
  "name": "claude-workspace",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:project-picker-ui": "node scripts/project-picker-ui-test.mjs",
    "test:project-context-ui": "node scripts/project-context-ui-test.mjs",
    "test:chat-context-ui": "node scripts/chat-context-ui-test.mjs",
    "test:shared-history-ui": "node scripts/shared-history-ui-test.mjs",
    "test:message-actions-ui": "node scripts/message-actions-ui-test.mjs",
    "test:usage-ui": "node scripts/usage-ui-test.mjs",
    "test:navigation-ui": "node scripts/navigation-audit-ui-test.mjs",
    "test:commands-ui": "node scripts/commands-ui-test.mjs",
    "test:quick-memory-ui": "node scripts/quick-memory-ui-test.mjs",
    "test:model-image-input-ui": "node scripts/model-image-input-ui-test.mjs",
    "test:topology-ui": "node scripts/topology-ui-test.mjs",
    "test:topology-exploration-ui": "node scripts/topology-exploration-ui-test.mjs",
    "test:effort-slider-ui": "node scripts/effort-slider-ui-test.mjs",
    "test:agent-activity-ui": "node scripts/agent-activity-ui-test.mjs",
    "test:agent-merge-ui": "node scripts/agent-merge-ui-test.mjs",
    "test:changes-panel-ui": "node scripts/changes-panel-ui-test.mjs",
    "test:edit-menu-ui": "node scripts/edit-menu-ui-test.mjs",
    "test:code-review-real-cli": "node scripts/code-review-real-cli-test.cjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:approvals-ui": "node scripts/approvals-ui-test.mjs",
    "test:extensions-ui": "node scripts/extensions-ui-test.mjs",
    "test:settings-ui": "node scripts/settings-ui-test.mjs",
    "test:workbench-ui": "node scripts/workbench-ui-test.mjs",
    "test:gateway-retry-ui": "node scripts/gateway-retry-ui-test.mjs",
    "test:model-routing-ui": "node scripts/model-routing-ui-test.mjs",
    "test:browser-ui": "node scripts/browser-ui-test.mjs",
    "test:browser-real-cli": "node scripts/browser-real-cli-test.mjs",
    "test:model-profile-ui": "node scripts/model-profile-ui-test.mjs",
    "test:browser-protocols": "node scripts/browser-protocols-test.mjs",
    "test:providers-persistence-ui": "node scripts/providers-persistence-ui-test.mjs",
    "test:providers-real-cli": "node scripts/provider-real-cli-smoke.cjs",
    "test:workbench-real-cli": "node scripts/workbench-real-cli-test.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "pack:win": "npm run build && electron-builder --win nsis portable --x64",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir",
    "test:topology-flow-ui": "node scripts/topology-flow-ui-test.mjs",
    "test:topology-workflow-ui": "node scripts/topology-workflow-ui-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  },
  "description": "Desktop workspace for the installed Claude Code CLI",
  "author": "Claude Workspace"
}
